# Host nginx vhost for the Sec-Agent controller (docker compose publishes it on 127.0.0.1:8700).
# Install:
#   sudo cp deploy/sec-agent.naurzalinov.me /etc/nginx/sites-available/
#   sudo ln -s /etc/nginx/sites-available/sec-agent.naurzalinov.me /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d sec-agent.naurzalinov.me          # adds the 443/redirect blocks
server {
    listen 80;
    server_name sec-agent.naurzalinov.me;


    location / {
        proxy_pass http://127.0.0.1:8700;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # LLM round-trips can be slow
    }
}
