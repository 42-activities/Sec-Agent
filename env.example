# Copy to .env and fill in:  cp env.example .env
# .env is gitignored — never commit real credentials.
#
# Amazon Bedrock API key (bearer token). For the hackathon (Workshop Studio):
#   Bedrock console -> API keys -> create a short-term key. Expires ~12h; regenerate when it does.
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-xxxxxxxx

AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# Model inference-profile IDs (us-west-2). Bare "anthropic.*" IDs do NOT work on-demand —
# use the "us.anthropic.*" inference-profile IDs. List what your account has with:
#   aws bedrock list-inference-profiles --region us-west-2
EXECUTOR_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
SECURITY_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Shared secret between the controller and proxy containers (docker compose).
# Generate with: openssl rand -hex 32
PROXY_AUTH_TOKEN=change-me

# Password for editing the policy rules at /rules. Leave empty to disable editing.
RULES_ADMIN_TOKEN=

# Jev (TypeSafe AI) prompt-injection risk scoring of untrusted input — optional.
# Untrusted documents are sent to TypeSafe for scoring. Key: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Gmail (read-only), "Sign in with Google" per visitor — optional; empty = off.
# Google Cloud console -> APIs & Services: enable the Gmail API, create an OAuth client
# (type "Web application") with redirect URI <PUBLIC_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://127.0.0.1:8000
