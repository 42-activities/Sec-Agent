# Copy to .env and fill in:  cp env.example .env
# .env is gitignored — never commit real credentials.
#
# Amazon Bedrock API key (bearer token). For the hackathon (Workshop Studio):
#   Bedrock console -> API keys -> create a short-term key. Expires ~12h; regenerate when it does.
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-xxxxxxxx

AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# Model inference-profile IDs (us-west-2). Bare "anthropic.*" IDs do NOT work on-demand —
# use the "us.anthropic.*" inference-profile IDs. List what your account has with:
#   aws bedrock list-inference-profiles --region us-west-2
EXECUTOR_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
SECURITY_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Shared secret between the controller and proxy containers (docker compose).
# Generate with: openssl rand -hex 32
PROXY_AUTH_TOKEN=change-me
